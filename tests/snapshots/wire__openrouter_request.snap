                      "type": "string"
                    },
                    "type": "array"
                  },
                  "program": {
                    "description": "Bare name of an allowed tool.",
                    "type": "string"
                  }
                },
                "required": [
                  "program",
                  "args"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "explanation": {
              "description": "One sentence: what the pipeline does, or why it can't be done.",
              "type": "string"
            }
          },
          "required": [
            "commands",
            "explanation"
          ],
          "type": "object"
        },
